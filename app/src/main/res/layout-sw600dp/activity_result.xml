<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="64dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/result_title"
            android:textSize="52sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvQuestionnaireName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textColor="#6B7280"
            android:gravity="center"
            android:layout_marginBottom="48dp"/>

        <!-- Punteggio normale DLQI e WHO-5 -->
        <TextView
            android:id="@+id/tvScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="130sp"
            android:textStyle="bold"
            android:textColor="#1D9E75"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvMaxScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            android:textColor="#6B7280"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/tvInterpretation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E"
            android:gravity="center"
            android:layout_marginBottom="48dp"/>

        <!-- Punteggio doppio HADS -->
        <LinearLayout
            android:id="@+id/llHadsScores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ansia"
                android:textSize="22sp"
                android:textColor="#6B7280"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvAnxietyScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="60sp"
                android:textStyle="bold"
                android:textColor="#1D9E75"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvAnxietyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"
                android:layout_marginBottom="40dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Depressione"
                android:textSize="22sp"
                android:textColor="#6B7280"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvDepressionScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="60sp"
                android:textStyle="bold"
                android:textColor="#1D9E75"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvDepressionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/result_footer"
            android:textSize="22sp"
            android:textColor="#9CA3AF"
            android:gravity="center"
            android:layout_marginBottom="48dp"/>

        <Button
            android:id="@+id/btnFinish"
            android:layout_width="500dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_finish"
            android:textSize="26sp"
            android:backgroundTint="#1D9E75"
            android:textColor="#FFFFFF"
            android:padding="20dp"/>

    </LinearLayout>
</ScrollView>